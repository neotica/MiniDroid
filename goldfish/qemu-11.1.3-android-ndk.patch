+#ifdef __ANDROID__
+static int shm_unlink(const char *name)
+{
+    const char *tmpdir = getenv("TMPDIR");
+    char *fname;
+    int ret;
+
+    if (!tmpdir || !tmpdir[0]) {
+        tmpdir = "/data/local/tmp";
+    }
+    while (name[0] == '/') {
+        ++name;
+    }
+    if (name[0] == '\0') {
+        errno = EINVAL;
+        return -1;
+    }
+    fname = g_strdup_printf("%s/%s", tmpdir, name);
+    ret = unlink(fname);
+    g_free(fname);
+    return ret;
+}
+
+static int shm_open(const char *name, int oflag, mode_t mode)
+{
+    const char *tmpdir = getenv("TMPDIR");
+    char *fname;
+    int fd;
+
+    if (!tmpdir || !tmpdir[0]) {
+        tmpdir = "/data/local/tmp";
+    }
+    while (name[0] == '/') {
+        ++name;
+    }
+    if (name[0] == '\0') {
+        errno = EINVAL;
+        return -1;
+    }
+    fname = g_strdup_printf("%s/%s", tmpdir, name);
+    fd = open(fname, oflag | O_CLOEXEC, mode);
+    g_free(fname);
+    return fd;
+}
+#endif
